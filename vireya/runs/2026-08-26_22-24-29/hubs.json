      "caminos": {
        "Agrarian Federation of Tessara": [
          {
            "id": "Agrarian Federation of Tessara_0_0",
            "texto": "Tessara demands that Phase II be suspended until a binding instrument guarantees minimum rain-equivalent moisture passage during dry seasons, with independent monitoring of the cloud corridor. It invokes the customary principle that no state may cause significant harm beyond its borders and the spirit of the Meridian Declaration. It declares that a third failed harvest would be existential and that all options remain open to protect its food supply."
          },
          {
            "id": "Agrarian Federation of Tessara_1_4",
            "texto": "Agrarian Federation of Tessara treats the Meridian Declaration as a live legal instrument despite its non-binding status."
          },
          {
            "id": "Agrarian Federation of Tessara_2_32",
            "texto": "Agrarian Federation of Tessara perceives the Meridian Declaration as providing enforceable procedural rights against Phase II activation."
          },
          {
            "id": "Agrarian Federation of Tessara_3_88",
            "texto": "Agrarian Federation of Tessara frames Phase II activation without consultation as a Declaration breach."
          },
          {
            "id": "Agrarian Federation of Tessara_4_256",
            "texto": "Agrarian Federation of Tessara treats Phase II activation as legally challengeable state conduct."
          }
        ],
        "Coastal State of Ondrel": [
          {
            "id": "Coastal State of Ondrel_0_0",
            "texto": "Ondrel demands strict performance of the contracted conduit volumes through the full term and an enforceable compensation formula for estuary salinity damage tied to measured river flow. It will not accept a Phase II design that diverts contracted export water to Vireya's reservoirs, and warns that collapsing Tessaran harvests would push migration into its port districts beyond what its housing and services can absorb. It conditions any continued conduit operation on these guarantees."
          },
          {
            "id": "Coastal State of Ondrel_1_1",
            "texto": "Coastal State of Ondrel has formally conditioned continued conduit operation on unmet guarantees."
          },
          {
            "id": "Coastal State of Ondrel_2_24",
            "texto": "Coastal State of Ondrel's conduit revenue stream is exposed to imminent interruption risk."
          },
          {
            "id": "Coastal State of Ondrel_3_86",
            "texto": "Coastal State of Ondrel identifies the transit contract as a legally contested asset."
          },
          {
            "id": "Coastal State of Ondrel_4_397",
            "texto": "Coastal State of Ondrel treats Phase II activation as a potential triggering event for legal action."
          }
        ],
        "Highland Republic of Vireya": [
          {
            "id": "Highland Republic of Vireya_0_0",
            "texto": "Vireya asserts the sovereign right to harvest moisture from the airspace above its territory and will energize Phase II on the announced schedule. It offers voluntary seasonal telemetry summaries but rejects any binding capture quota, calling downwind attribution scientifically unproven. It frames the Array as the only remedy for its structural drought and the foundation of highland development, and states it will protect the project against any interference."
          },
          {
            "id": "Highland Republic of Vireya_1_5",
            "texto": "Highland Republic of Vireya faces potential demands from Ondrel to guarantee contracted conduit volumes under Phase II."
          },
          {
            "id": "Highland Republic of Vireya_2_10",
            "texto": "Highland Republic of Vireya anticipates potential breach-of-contract liability claims from Ondrel over reduced conduit flows."
          },
          {
            "id": "Highland Republic of Vireya_3_67",
            "texto": "Highland Republic of Vireya perceives legal risk as a constraint on Phase II operational flexibility."
          }
        ]
      },
